---
const EMAIL = 'kevinrodriguezdev@gmail.com';
const types = ['Landing page', 'Catálogo o web de producto', 'Web de marca con animación', 'Rediseño de una web existente', 'Otro / aún no lo sé'];
---
<section id="contacto" class="section contact">
  <div class="wrap grid">
    <div class="intro" data-reveal>
      <p class="label">05 — Contacto</p>
      <h2>¿Empezamos tu <em>web</em>?</h2>
      <p>Cuéntanos qué necesitas y te respondemos con ideas y un presupuesto sin compromiso.</p>
      <div class="mail">
        <span class="label">Escríbenos a</span>
        <a href={`mailto:${EMAIL}`} class="addr">{EMAIL}</a>
      </div>
    </div>

    <form id="contact-form" class="form" data-reveal style="--d:.1s" data-email={EMAIL} novalidate>
      <div class="field">
        <label for="f-name">Nombre</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="f-company">Negocio <span class="opt">(opcional)</span></label>
        <input id="f-company" name="company" type="text" autocomplete="organization" />
      </div>
      <div class="field">
        <label for="f-email">Tu email</label>
        <input id="f-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="f-type">Tipo de proyecto</label>
        <select id="f-type" name="type">
          {types.map((t) => <option>{t}</option>)}
        </select>
      </div>
      <div class="field full">
        <label for="f-msg">Cuéntanos tu idea</label>
        <textarea id="f-msg" name="message" rows="5" required placeholder="Qué vende tu negocio, qué quieres conseguir con la web, plazos, referencias que te gusten…"></textarea>
      </div>
      <div class="full foot">
        <button type="submit" class="btn btn-primary">Preparar email <span class="arrow" aria-hidden="true">→</span></button>
        <p class="hint" id="f-status" role="status">Se abrirá tu aplicación de correo con el mensaje listo para enviar.</p>
      </div>
    </form>
  </div>
</section>
<style>
  .contact { border-top: 1px solid var(--line); }
  .grid { display: grid; gap: 3.5rem; }
  h2 { font-size: clamp(2.6rem, 6vw, 4.75rem); margin-top: 1.25rem; }
  h2 em { color: var(--lacre); }
  .intro > p:not(.label) { margin-top: 1.4rem; color: var(--ink-2); font-size: 1.15rem; max-width: 28rem; }
  .mail { margin-top: 2.5rem; display: grid; gap: .5rem; }
  .addr { font-family: var(--serif); font-size: clamp(1.2rem, 2.4vw, 1.7rem); text-decoration: none; border-bottom: 1px solid var(--lacre); justify-self: start; overflow-wrap: anywhere; }
  .addr:hover { color: var(--lacre); }

  .form { display: grid; gap: 1.5rem 1.75rem; grid-template-columns: minmax(0, 1fr); }
  .field { display: grid; gap: .45rem; }
  label { font-family: var(--mono); font-size: .74rem; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2); }
  .opt { text-transform: none; letter-spacing: 0; color: var(--ink-3); }
  input, select, textarea {
    font: inherit; font-size: 1.05rem; color: var(--ink); width: 100%;
    background: transparent; border: 0; border-bottom: 1px solid rgba(23,20,15,.35); border-radius: 0;
    padding: .6rem 0; transition: border-color .2s;
  }
  select { appearance: none; -webkit-appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--ink) 50%), linear-gradient(135deg, var(--ink) 50%, transparent 50%); background-position: calc(100% - 10px) 55%, calc(100% - 5px) 55%; background-size: 5px 5px; background-repeat: no-repeat; padding-right: 1.5rem; }
  textarea { resize: vertical; min-height: 8rem; line-height: 1.5; }
  input:focus, select:focus, textarea:focus { outline: none; border-bottom-color: var(--lacre); box-shadow: 0 1px 0 var(--lacre); }
  [aria-invalid='true'] { border-bottom-color: var(--lacre); }
  ::placeholder { color: var(--ink-3); opacity: .8; }
  .foot { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: .5rem; }
  .hint { font-size: .9rem; color: var(--ink-3); max-width: 24rem; }
  .hint.err { color: var(--lacre); }
  @media (min-width: 640px) { .form { grid-template-columns: repeat(2, minmax(0, 1fr)); } .full { grid-column: 1 / -1; } }
  @media (min-width: 1000px) { .grid { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 5rem; } }
</style>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('f-status');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const get = (k: string) => String(data.get(k) ?? '').trim();
    const name = get('name'), email = get('email'), msg = get('message'), company = get('company'), type = get('type');

    let firstBad: HTMLElement | null = null;
    for (const [k, ok] of [['name', !!name], ['email', /^\S+@\S+\.\S+$/.test(email)], ['message', !!msg]] as const) {
      const el = form.elements.namedItem(k) as HTMLElement;
      el.setAttribute('aria-invalid', String(!ok));
      if (!ok && !firstBad) firstBad = el;
    }
    if (firstBad) {
      firstBad.focus();
      if (status) { status.textContent = 'Revisa los campos marcados: nombre, un email válido y tu mensaje.'; status.classList.add('err'); }
      return;
    }

    const subject = `Proyecto web: ${type}${company ? ` · ${company}` : ''}`;
    const body = [
      `Hola, soy ${name}${company ? ` (${company})` : ''}.`,
      '',
      `Tipo de proyecto: ${type}`,
      '',
      msg,
      '',
      `Mi email de contacto: ${email}`,
    ].join('\n');
    location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    if (status) { status.textContent = `Abriendo tu aplicación de correo… Si no se abre, escríbenos directamente a ${form.dataset.email}.`; status.classList.remove('err'); }
  });
</script>
