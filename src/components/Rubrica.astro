---
// The studio's "signature" flourish: a hand-drawn stroke that underlines a word.
interface Props { class?: string; draw?: boolean }
const { class: cls = '', draw = false } = Astro.props;
---
<svg class:list={['rubrica', cls, { draw }]} viewBox="0 0 320 40" fill="none" aria-hidden="true" preserveAspectRatio="none">
  <path pathLength="1" d="M4 27c28-9 61-15 96-15 30 0 44 9 29 15-14 6-28-4-9-11 27-10 81-12 128-9 25 2 46 5 68 10" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
</svg>
<style>
  .rubrica { display: block; overflow: visible; color: var(--lacre); }
  .rubrica.draw path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: firma 1.6s 0.5s var(--ease) forwards; }
  @keyframes firma { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .rubrica.draw path { stroke-dashoffset: 0; animation: none; } }
</style>
