---
import Logo from './Logo.astro';
const links = [
  ['#proyectos', 'Proyectos'],
  ['#servicios', 'Servicios'],
  ['#proceso', 'Proceso'],
  ['#sobre-mi', 'Sobre mí'],
];
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="home" aria-label="Webrica, inicio"><Logo /></a>
    <nav aria-label="Principal">
      <ul>
        {links.map(([href, text]) => <li><a href={href}>{text}</a></li>)}
      </ul>
    </nav>
    <a class="cta" href="#contacto">Hablemos <span aria-hidden="true">→</span></a>
  </div>
</header>
<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color .3s;
  }
  .site-header.scrolled { border-bottom-color: var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; height: 4.5rem; }
  .home { text-decoration: none; color: var(--ink); }
  nav ul { list-style: none; display: flex; gap: 2.25rem; margin: 0; padding: 0; }
  nav a { text-decoration: none; font-size: .95rem; color: var(--ink-2); position: relative; padding-block: .25rem; }
  nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 1px; background: var(--lacre); transform: scaleX(0); transform-origin: left; transition: transform .3s var(--ease); }
  nav a:hover { color: var(--ink); }
  nav a:hover::after { transform: scaleX(1); }
  .cta { font-family: var(--mono); font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; text-decoration: none; padding: .6rem .95rem; border: 1px solid var(--ink); border-radius: 2px; transition: background .25s, color .25s; white-space: nowrap; }
  .cta:hover { background: var(--ink); color: var(--paper); }
  @media (max-width: 860px) { nav { display: none; } }
</style>
<script>
  const h = document.querySelector('.site-header');
  const on = () => h?.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', on, { passive: true }); on();
</script>
