---
import Frame from './Frame.astro';
import Phone from './Phone.astro';

const projects = [
  {
    id: 'genesis',
    n: '01',
    name: 'Génesis',
    client: "God's Time",
    kind: 'Landing de producto · Relojería de lujo',
    url: 'https://godstime-genesis.vercel.app',
    host: 'godstime-genesis.vercel.app',
    intro:
      'Concepto de landing para el cronógrafo Génesis de God’s Time. Una pieza editorial, en negro y oro, donde el scroll desmonta el reloj capa a capa y lo vuelve a montar ante los ojos del visitante.',
    features: [
      'Animación ligada al scroll: el reloj se despieza en cristal de zafiro, esfera azul sunray, calibre japonés Miyota y fondo grabado con el ángel, y después se recompone.',
      'Anotaciones sobre el calibre que aparecen en el momento justo del recorrido.',
      'Diseño editorial de lujo: tipografía clásica, colección de tres modelos, ficha técnica y lista de espera.',
      'Respeta la preferencia de movimiento reducido del sistema.',
    ],
    stack: ['Vite', 'JavaScript vanilla', 'CSS'],
    main: { name: 'genesis-calibre', alt: 'Génesis a mitad de la animación: el calibre Miyota a la vista con anotaciones sobre sus piezas' },
    second: { name: 'genesis-despiece', alt: 'Génesis durante el despiece: la esfera azul se separa y deja ver el movimiento' },
    phone: { name: 'genesis-movil', alt: 'Portada de Génesis en móvil' },
  },
  {
    id: '3dpanda',
    n: '02',
    name: '3DPanda',
    client: '3DPanda',
    kind: 'Catálogo de producto · Impresión 3D',
    url: 'https://3dpanda-pi.vercel.app',
    host: '3dpanda-pi.vercel.app',
    intro:
      'Web catálogo para un negocio de impresión 3D por encargo: figuras, decoración, organización y accesorios gaming. Pensada para enseñar el producto y convertir la visita en un pedido por WhatsApp.',
    features: [
      'Catálogo con filtro por categorías (figuras, decoración, hogar, gaming, coleccionismo y regalos) y una página propia para cada categoría.',
      'Ficha de producto con galería, medidas, material y etiqueta de “personalizable”.',
      'Botón de WhatsApp con el mensaje ya escrito con el nombre del producto, y página de encargos personalizados.',
      'Imágenes optimizadas automáticamente a WebP en varios tamaños; productos gestionados como archivos Markdown, fáciles de ampliar.',
    ],
    stack: ['Astro', 'TypeScript', 'CSS'],
    main: { name: 'panda-hero', alt: 'Portada de 3DPanda con figuras impresas en 3D sobre fondo claro' },
    second: { name: 'panda-catalogo', alt: 'Catálogo de 3DPanda con filtros por categoría y tarjetas de producto' },
    phone: { name: 'panda-movil', alt: 'Portada de 3DPanda en móvil' },
  },
];
---
<section id="proyectos" class="projects section">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="label">01 — Proyectos</p>
      <h2>Trabajo <em>firmado</em>, en producción.</h2>
      <p>Dos webs reales, publicadas y funcionando. Distintos sectores, el mismo cuidado: cada una diseñada desde cero para lo que su negocio necesita vender.</p>
    </header>

    {
      projects.map((p, i) => (
        <article class:list={['case', { flip: i % 2 === 1 }]} id={p.id} aria-labelledby={`${p.id}-t`}>
          <div class="info" data-reveal>
            <p class="num">{p.n}</p>
            <p class="label kind">{p.kind}</p>
            <h3 id={`${p.id}-t`}>
              {p.name}
              {p.client !== p.name && <span class="client"> — {p.client}</span>}
            </h3>
            <p class="intro">{p.intro}</p>
            <ul class="features">
              {p.features.map((f) => <li>{f}</li>)}
            </ul>
            <ul class="stack" aria-label="Tecnologías">
              {p.stack.map((s) => <li>{s}</li>)}
            </ul>
            <a class="live" href={p.url} target="_blank" rel="noopener">
              Ver web en directo <span aria-hidden="true">↗</span>
              <span class="host">{p.host}</span>
            </a>
          </div>

          <div class="media">
            <div data-reveal>
              <Frame dark name={p.main.name} alt={p.main.alt} url={p.host} sizes="(min-width: 960px) 58vw, 92vw" />
            </div>
            <div class="row">
              <div data-reveal style="--d:.1s">
                <Frame dark name={p.second.name} alt={p.second.alt} url={p.host} sizes="(min-width: 960px) 40vw, 62vw" />
              </div>
              <div data-reveal style="--d:.2s">
                <Phone name={p.phone.name} alt={p.phone.alt} />
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
<style>
  .projects { background: var(--night); color: var(--cream); }
  .projects :global(.section-head p:not(.label)) { color: var(--cream-2); }
  .projects .label { color: var(--cream-2); }
  .projects .section-head h2 :global(em), .projects .section-head :global(em) { color: var(--lacre-2); }

  .case { display: grid; gap: 2.5rem; padding-block: clamp(3rem, 6vw, 5rem); border-top: 1px solid var(--night-line); }
  .num { font-family: var(--serif); font-size: clamp(3.5rem, 7vw, 5.5rem); line-height: 1; color: var(--lacre-2); font-style: italic; font-weight: 300; }
  .kind { margin-top: 1.25rem; }
  h3 { font-size: clamp(2.2rem, 4.4vw, 3.4rem); margin-top: .6rem; }
  .client { font-style: italic; color: var(--cream-2); font-size: .62em; letter-spacing: -.01em; }
  .intro { margin-top: 1.25rem; color: var(--cream); font-size: 1.1rem; max-width: 34rem; }
  .features { list-style: none; padding: 0; margin: 1.75rem 0 0; display: grid; gap: .85rem; max-width: 34rem; }
  .features li { position: relative; padding-left: 1.6rem; color: var(--cream-2); font-size: .98rem; line-height: 1.55; }
  .features li::before { content: ''; position: absolute; left: 0; top: .72em; width: .8rem; height: 1px; background: var(--lacre-2); }
  .stack { list-style: none; padding: 0; margin: 1.75rem 0 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .stack li { font-family: var(--mono); font-size: .72rem; letter-spacing: .04em; padding: .35rem .6rem; border: 1px solid var(--night-line); border-radius: 2px; color: var(--cream-2); }
  .live { display: inline-grid; grid-template-columns: auto auto; column-gap: .5rem; align-items: baseline; margin-top: 2rem; text-decoration: none; font-family: var(--serif); font-size: 1.4rem; font-style: italic; color: var(--cream); border-bottom: 1px solid var(--lacre-2); padding-bottom: .35rem; transition: color .25s; }
  .live:hover { color: var(--lacre-2); }
  .live .host { grid-column: 1 / -1; font-family: var(--mono); font-style: normal; font-size: .72rem; color: var(--cream-2); margin-top: .2rem; }

  .media { display: grid; gap: 1.25rem; min-width: 0; }
  .row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .36fr); gap: 1.25rem; align-items: end; }

  @media (min-width: 960px) {
    .case { grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr); gap: 4.5rem; align-items: start; }
    .info { position: sticky; top: 6.5rem; }
    .case.flip { grid-template-columns: minmax(0, 1.22fr) minmax(0, .78fr); }
    .case.flip .info { order: 2; }
    .case.flip .media { order: 1; }
  }
</style>
