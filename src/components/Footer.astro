---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="top">
      <p class="big">Webs hechas a mano,<br /><em>firmadas</em> con cuidado.</p>
      <a class="btn" href="#contacto">Hablemos <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <div class="bottom">
      <a href="/" class="home" aria-label="Webrica, inicio"><Logo /></a>
      <ul>
        <li><a href="mailto:kevinrodriguezdev@gmail.com">kevinrodriguezdev@gmail.com</a></li>
        <li><a href="https://kevinrodriguezdev.vercel.app" target="_blank" rel="noopener">Portfolio</a></li>
        <li><a href="https://kevin-minimalist-portfolio.vercel.app" target="_blank" rel="noopener">CV</a></li>
      </ul>
      <p class="label">© {year} Webrica · Kevin Rodríguez · España</p>
    </div>
  </div>
</footer>
<style>
  .footer { background: var(--night); color: var(--cream); padding-block: clamp(4rem, 9vw, 7rem) 2.5rem; --logo-bg: var(--night); }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 2rem; padding-bottom: clamp(3rem, 6vw, 5rem); border-bottom: 1px solid var(--night-line); }
  .big { font-family: var(--serif); font-size: clamp(2.2rem, 5.5vw, 4.5rem); line-height: 1.02; letter-spacing: -.03em; font-weight: 350; }
  .big em { color: var(--lacre-2); }
  .btn { color: var(--cream); border-color: var(--cream); }
  .btn:hover { background: var(--cream); color: var(--night); }
  .bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2rem; padding-top: 2rem; }
  .home { text-decoration: none; color: var(--cream); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem 1.75rem; }
  ul a { text-decoration: none; color: var(--cream-2); font-size: .95rem; overflow-wrap: anywhere; }
  ul a:hover { color: var(--cream); }
  .label { color: var(--cream-2); }
</style>
